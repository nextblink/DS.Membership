{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "DS.Membership",
    "Audience": "DS.Membership.Client",
    "SecretKey": "REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS_FOR_HS256",
    "ExpiresMinutes": 60
  },
  "QrUpload": {
    "Secret": "REPLACE_WITH_RANDOM_32_CHAR_SECRET_FOR_QR_UPLOAD"
  },
  "FileStorage": {
    "UploadRoot": "wwwroot/uploads",
    "MaxBytesPerFile": 10485760,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".pdf" ],
    "AllowedMimeTypes": [ "image/jpeg", "image/png", "image/webp", "application/pdf" ]
  }
}
